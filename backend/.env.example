APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CẤU HÌNH THANH TOÁN (SEPAY / WEB2M)
PAYMENT_GATEWAY=sepay
PAYMENT_TEST_MODE=false
ALLOW_MOCK_AUTH=false

# CẤU HÌNH SEPAY (KHUYÊN DÙNG CHO TPBANK - CÁCH 1 POLLING API)
SEPAY_API_KEY=
SEPAY_WEBHOOK_KEY=

# CẤU HÌNH TÀI KHOẢN NGÂN HÀNG (TPBANK)
BANK_CODE=TPB
ACCOUNT_NO=
ACCOUNT_NAME=
PENDING_TTL_SECONDS=900

# CORS & STATEFUL DOMAINS
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
SANCTUM_STATEFUL_DOMAINS="localhost:3000,127.0.0.1:3000"

# CẤU HÌNH DỰ PHÒNG WEB2M
WEB2M_TOKEN=
WEB2M_PASSWORD=

# DISCORD OAUTH2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="http://localhost:3000/auth/discord/callback"
DISCORD_ALLOWED_REDIRECTS="http://localhost:3000/auth/discord/callback,https://taphoa247.io.vn/auth/discord/callback,http://127.0.0.1:3000/auth/discord/callback"

# FACEBOOK CONVERSIONS API / PIXEL (TÙY CHỌN CHẠY QUẢNG CÁO)
# FACEBOOK_PIXEL_ID=
# FACEBOOK_CAPI_TOKEN=


# CỔNG THANH TOÁN APP ANDROID GATEWAY
# Sinh ngẫu nhiên: php -r "echo bin2hex(random_bytes(32));"
DEVICE_GATEWAY_SECRET=

# CA bundle path for Windows/local PHP if the PHP installation has no default trust store.
# Leave empty to use the system CA store. Never disable TLS certificate verification.
TLS_CA_BUNDLE=

# DEV SECRET (DÙNG CHO TEST PAY KHI PHÁT TRIỂN)
# Sinh ngẫu nhiên: php -r "echo bin2hex(random_bytes(32));"
APP_DEV_SECRET=

# SUPPLIER INTEGRATION (LOCAL SECRETS ONLY)
DIGISHOP_GATEWAY_KEY=
DIGISHOP_RESELLER_KEY=
SHOPMMO_API_KEY=
